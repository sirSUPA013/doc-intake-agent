# Copy this file to .env and fill in. .env is gitignored — never commit it.

ANTHROPIC_API_KEY=

# Optional: override the model (defaults to claude-haiku-4-5-20251001)
# CLAUDE_MODEL=claude-sonnet-4-6

# --- Live-mode gate (web demo) ---
# PIN that unlocks live mode. Empty = live mode disabled (demo only).
DEMO_PIN=
# Secret for signing the unlock cookie. Set in production; falls back to the PIN.
SESSION_SECRET=
# Daily cap on live (real-model) extractions; falls back to demo mode when hit.
DAILY_LIVE_CAP=50
# Max input size in bytes per extraction.
MAX_INPUT_BYTES=20000
